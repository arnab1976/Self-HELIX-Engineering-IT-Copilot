# Copy to .env and adjust. Every value has a safe local default.
HELIX_ENV=dev                         # dev enables /v1/dev/token and the mock LLM
HELIX_DATA_DIR=./data
HELIX_STATE_DIR=./var                 # SQLite stores, trained artefacts, indexes, registry
HELIX_JWT_SECRET=dev-only-helix-jwt-secret-change-me-0001   # dev HS256 key (>=32 bytes); production uses OIDC (JWKS)
HELIX_OIDC_ISSUER=                    # e.g. https://login.microsoftonline.com/<tenant>/v2.0
HELIX_OIDC_AUDIENCE=api://helix
HELIX_APPROVAL_SECRET=dev-only-helix-approval-secret-change-me  # HMAC key for action approval tokens

# Model endpoints (OpenAI-compatible: vLLM, Ollama /v1, TGI, OpenAI, Azure OpenAI)
# Leave blank to use the deterministic mock provider for that tier.
HELIX_T1A_URL=                        # FIM completion, e.g. http://localhost:11434/v1 (Ollama)
HELIX_T1A_MODEL=qwen2.5-coder:1.5b-base
HELIX_T1B_URL=                        # code chat / review
HELIX_T1B_MODEL=qwen2.5-coder:7b-instruct
HELIX_T1C_URL=                        # text-to-query + incident
HELIX_T1C_MODEL=llama3.1:8b-instruct
HELIX_T2_URL=                         # general instruct
HELIX_T2_MODEL=llama3.1:8b-instruct
HELIX_T3_URL=                         # frontier, private endpoint with zero data retention
HELIX_T3_MODEL=
HELIX_T3_API_KEY=

# Optional external services (docker-compose). Blank = in-process fallback.
HELIX_OPA_URL=                        # http://localhost:8181
HELIX_QDRANT_URL=                     # http://localhost:6333
HELIX_EMBEDDINGS_URL=                 # TEI endpoint, e.g. http://localhost:8080
HELIX_LANGFUSE_HOST=
HELIX_LANGFUSE_PUBLIC_KEY=
HELIX_LANGFUSE_SECRET_KEY=
HELIX_GITHUB_TOKEN=                   # real git tools on your own repos
